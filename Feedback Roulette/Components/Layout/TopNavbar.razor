@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.AspNetCore.Identity
@using FeedbackRoulette_ClassLibrary
@using Feedback_Roulette.Services
@using Microsoft.JSInterop
@using System.Threading.Tasks

@inject UserManager<ApplicationUser> UserManager
@inject AuthenticationStateProvider AuthStateProvider
@inject INotificationService NotificationService
@inject NavigationManager NavigationManager
@inject IJSRuntime JSRuntime

@rendermode InteractiveServer

@implements IDisposable

<nav class="top-navbar">
    <div class="navbar-container">
        <div class="navbar-brand">
            <a href="/">
                <img src="/images/feedback_roulette_logo.png" alt="Feedback Roulette Logo" class="nav-logo" />
                <span class="brand-text">FEEDBACK ROULETTE</span>
            </a>
        </div>

        <div class="navbar-actions">
            <AuthorizeView>
                <Authorized>
                    <div class="navbar-icons">
                        <div class="notification-bell-container" @ref="notificationRef">
                            <button class="notification-bell-btn" @onclick="ToggleNotificationDropdown">
                                <i class="bi bi-bell"></i>
                                @if (unreadCount > 0)
                                {
                                    <span class="notification-badge"></span>
                                }
                            </button>

                            @if (showNotifications)
                            {
                                <div class="notification-dropdown" @onclick:stopPropagation>
                                    <div class="notification-header">
                                        <h6>Notifications</h6>
                                        @if (notifications.Any(n => !n.IsRead))
                                        {
                                            <button class="mark-all-read-btn" @onclick="MarkAllAsRead">
                                                Mark all read
                                            </button>
                                        }
                                    </div>

                                    <div class="notification-list">
                                        @if (notifications.Count == 0)
                                        {
                                            <div class="no-notifications">
                                                <i class="bi bi-bell-slash"></i>
                                                <p>No notifications yet</p>
                                            </div>
                                        }
                                        else
                                        {
                                            foreach (var notification in notifications)
                                            {
                                                <div class="notification-item @(notification.IsRead ? "read" : "unread")"
                                                     @onclick="() => HandleNotificationClick(notification)">
                                                    <div class="notification-content">
                                                        <p>@notification.Message</p>
                                                        <small>@notification.CreatedAt.ToString("MMM dd, yyyy")</small>
                                                    </div>
                                                    @if (!notification.IsRead)
                                                    {
                                                        <div class="unread-indicator"></div>
                                                    }
                                                </div>
                                            }
                                        }
                                    </div>
                                </div>
                            }
                        </div>

                        <div class="user-profile-nav">
                            <a href="dashboard" class="profile-link">
                                <img src="@(avatarSrc ?? $"https://ui-avatars.com/api/?name={context.User.Identity?.Name ?? "User"}&background=5D5FEF&color=fff")" alt="Profile" class="nav-avatar"/>
                            </a>
                        </div>
                    </div>
                </Authorized>
                <NotAuthorized>
                    <div class="auth-buttons">
                        <a href="Account/Login" class="btn-login">Login</a>
                        <a href="Account/Register" class="btn-register">Register</a>
                    </div>
                </NotAuthorized>
            </AuthorizeView>
        </div>
    </div>
</nav>

@code {
    private string? avatarSrc;
    private List<Notification> notifications = new();
    private int unreadCount = 0;
    private bool showNotifications = false;
    private ElementReference notificationRef;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            var authState = await AuthStateProvider.GetAuthenticationStateAsync();
            var user = authState.User;
            
            if (user.Identity?.IsAuthenticated == true)
            {
                var userId = UserManager.GetUserId(user);
                if (!string.IsNullOrEmpty(userId))
                {
                    var appUser = await UserManager.FindByIdAsync(userId);
                    avatarSrc = appUser?.ProfileImageUrl;
                    
                    await LoadNotifications(userId);
                    StateHasChanged();
                }
            }
            
            await JSRuntime.InvokeVoidAsync("registerClickOutside", notificationRef, DotNetObjectReference.Create(this));
        }
    }

    [JSInvokable]
    public void CloseNotificationDropdown()
    {
        if (showNotifications)
        {
            showNotifications = false;
            StateHasChanged();
        }
    }

    private async Task LoadNotifications(string userId)
    {
        notifications = await NotificationService.GetAllNotificationsAsync(userId);
        unreadCount = await NotificationService.GetUnreadCountAsync(userId);
    }

    private void ToggleNotificationDropdown()
    {
        showNotifications = !showNotifications;
    }

    private async Task MarkAllAsRead()
    {
        var authState = await AuthStateProvider.GetAuthenticationStateAsync();
        var userId = UserManager.GetUserId(authState.User);
        
        if (!string.IsNullOrEmpty(userId))
        {
            await NotificationService.MarkAllAsReadAsync(userId);
            await LoadNotifications(userId);
            StateHasChanged();
        }
    }

    private async Task HandleNotificationClick(Notification notification)
    {
        if (!notification.IsRead)
        {
            await NotificationService.MarkAsReadAsync(notification.Id);
            var authState = await AuthStateProvider.GetAuthenticationStateAsync();
            var userId = UserManager.GetUserId(authState.User);
            
            if (!string.IsNullOrEmpty(userId))
            {
                await LoadNotifications(userId);
            }
        }

        if (!string.IsNullOrEmpty(notification.Link))
        {
            NavigationManager.NavigateTo(notification.Link);
        }

        showNotifications = false;
    }
    
    public void Dispose()
    {
        JSRuntime.InvokeVoidAsync("unregisterClickOutside");
    }
}

<style>
    .top-navbar {
        position: sticky;
        top: 0;
        width: 100%;
        height: 70px;
        background-color: rgba(13, 13, 18, 0.8);
        backdrop-filter: blur(10px);
        border-bottom: 1px solid #2E2E3A;
        z-index: 1000;
        display: flex;
        align-items: center;
    }

    .navbar-container {
        max-width: 1200px;
        width: 100%;
        margin: 0 auto;
        padding: 0 2rem;
        display: flex;
        justify-content: space-between;
        align-items: center;
    }

    .navbar-brand a {
        display: flex;
        align-items: center;
        gap: 0.75rem;
        text-decoration: none;
        color: var(--text-main);
    }

    .nav-logo {
        height: 32px;
        width: auto;
    }

    .brand-text {
        font-weight: 700;
        letter-spacing: 1px;
        font-size: 1.1rem;
    }

    .navbar-actions {
        display: flex;
        align-items: center;
    }

    .auth-buttons {
        display: flex;
        gap: 1rem;
    }

    .btn-login {
        color: var(--text-main);
        text-decoration: none;
        font-weight: 500;
        padding: 0.5rem 1rem;
        transition: color 0.2s;
    }

    .btn-login:hover {
        color: var(--primary-purple);
    }

    .btn-register {
        background-color: var(--primary-purple);
        color: white;
        text-decoration: none;
        font-weight: 500;
        padding: 0.5rem 1.25rem;
        border-radius: 8px;
        transition: background-color 0.2s;
    }

    .btn-register:hover {
        background-color: var(--primary-purple-hover);
        color: white;
    }

    .nav-avatar {
        width: 40px;
        height: 40px;
        border-radius: 50%;
        border: 2px solid var(--primary-purple);
        transition: transform 0.2s;
    }

    .nav-avatar:hover {
        transform: scale(1.05);
    }
</style>
