@using Microsoft.AspNetCore.Components.Authorization

<nav class="top-navbar">
    <div class="navbar-container">
        <div class="navbar-brand">
            <a href="/">
                <img src="images/feedback_roulette_logo.png" alt="Feedback Roulette Logo" class="nav-logo" />
                <span class="brand-text">FEEDBACK ROULETTE</span>
            </a>
        </div>

        <div class="navbar-actions">
            <AuthorizeView>
                <Authorized>
                    <div class="user-profile-nav">
                        <a href="dashboard" class="profile-link">
                            <img src="https://ui-avatars.com/api/?name=@(context.User.Identity?.Name ?? "User")&background=5D5FEF&color=fff" alt="Profile" class="nav-avatar" />
                        </a>
                    </div>
                </Authorized>
                <NotAuthorized>
                    <div class="auth-buttons">
                        <a href="Account/Login" class="btn-login">Login</a>
                        <a href="Account/Register" class="btn-register">Register</a>
                    </div>
                </NotAuthorized>
            </AuthorizeView>
        </div>
    </div>
</nav>

<style>
    .top-navbar {
        position: sticky;
        top: 0;
        width: 100%;
        height: 70px;
        background-color: rgba(13, 13, 18, 0.8);
        backdrop-filter: blur(10px);
        border-bottom: 1px solid #2E2E3A;
        z-index: 1000;
        display: flex;
        align-items: center;
    }

    .navbar-container {
        max-width: 1200px;
        width: 100%;
        margin: 0 auto;
        padding: 0 2rem;
        display: flex;
        justify-content: space-between;
        align-items: center;
    }

    .navbar-brand a {
        display: flex;
        align-items: center;
        gap: 0.75rem;
        text-decoration: none;
        color: var(--text-main);
    }

    .nav-logo {
        height: 32px;
        width: auto;
    }

    .brand-text {
        font-weight: 700;
        letter-spacing: 1px;
        font-size: 1.1rem;
    }

    .navbar-actions {
        display: flex;
        align-items: center;
    }

    .auth-buttons {
        display: flex;
        gap: 1rem;
    }

    .btn-login {
        color: var(--text-main);
        text-decoration: none;
        font-weight: 500;
        padding: 0.5rem 1rem;
        transition: color 0.2s;
    }

    .btn-login:hover {
        color: var(--primary-purple);
    }

    .btn-register {
        background-color: var(--primary-purple);
        color: white;
        text-decoration: none;
        font-weight: 500;
        padding: 0.5rem 1.25rem;
        border-radius: 8px;
        transition: background-color 0.2s;
    }

    .btn-register:hover {
        background-color: var(--primary-purple-hover);
        color: white;
    }

    .nav-avatar {
        width: 40px;
        height: 40px;
        border-radius: 50%;
        border: 2px solid var(--primary-purple);
        transition: transform 0.2s;
    }

    .nav-avatar:hover {
        transform: scale(1.05);
    }
</style>
