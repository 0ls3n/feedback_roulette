@page "/"
@using Microsoft.AspNetCore.Components.Web
@using Microsoft.JSInterop
@rendermode InteractiveServer

<PageTitle>Feedback Roulette - Share, Review, Improve</PageTitle>

<section class="hero-section">
    <div class="hero-content">
        <h1 class="hero-title">Level Up Your <span class="accent-text">Craft</span> Through Peer Feedback</h1>
        <p class="hero-subtitle">The modern platform for musicians, developers, and creators to get high-quality feedback and help others grow.</p>
        <div class="hero-actions">
            <a href="Account/Register" class="cta-button">Get Started for Free</a>
            <a href="#how-it-works" class="secondary-button">How it Works</a>
        </div>
    </div>
</section>

<section class="tab-showcase-section">
    <div class="container">
        <div class="section-header text-center scroll-animate">
            <h2 class="section-title">Experience the Platform</h2>
            <p class="section-subtitle">A powerful set of tools designed to help you improve and connect.</p>
        </div>

        <div class="tabs-container scroll-animate">
            <div class="tabs-list">
                <button class="tab-btn @(activeTab == 0 ? "active" : "")" @onclick="() => SetTab(0)">
                    <i class="bi bi-search"></i>
                    <span>Discovery</span>
                </button>
                <button class="tab-btn @(activeTab == 1 ? "active" : "")" @onclick="() => SetTab(1)">
                    <i class="bi bi-upload"></i>
                    <span>Sharing</span>
                </button>
                <button class="tab-btn @(activeTab == 2 ? "active" : "")" @onclick="() => SetTab(2)">
                    <i class="bi bi-chat-left-dots"></i>
                    <span>Reviews</span>
                </button>
                <button class="tab-btn @(activeTab == 3 ? "active" : "")" @onclick="() => SetTab(3)">
                    <i class="bi bi-trophy"></i>
                    <span>Community</span>
                </button>
            </div>

            <div class="tab-content">
                <div class="tab-info">
                    <h3 class="tab-title">@tabs[activeTab].Title</h3>
                    <p class="tab-description">@tabs[activeTab].Description</p>
                    <ul class="tab-features">
                        @foreach (var feature in tabs[activeTab].Features)
                        {
                            <li><i class="bi bi-check2-circle"></i> @feature</li>
                        }
                    </ul>
                </div>
                <div class="tab-image-container">
                    <img src="@tabs[activeTab].ImageUrl" alt="@tabs[activeTab].Title" class="tab-image" />
                </div>
            </div>
        </div>
    </div>
</section>

<section id="how-it-works" class="how-it-works">
    <div class="container">
        <h2 class="section-title text-center scroll-animate">How It Works</h2>
        <div class="steps-grid">
            <div class="step-card scroll-animate">
                <div class="step-number">1</div>
                <h3>Upload Your Work</h3>
                <p>Share your latest project, whether it's a song, a piece of code, or a design. Set specific goals for the feedback you want.</p>
            </div>
            <div class="step-card scroll-animate" style="transition-delay: 0.15s;">
                <div class="step-number">2</div>
                <h3>Give to Earn</h3>
                <p>Provide high-quality reviews for others in the "Roulette" to earn credits. The better your feedback, the more you earn.</p>
            </div>
            <div class="step-card scroll-animate" style="transition-delay: 0.3s;">
                <div class="step-number">3</div>
                <h3>Receive & Improve</h3>
                <p>Use your earned credits to unlock detailed reviews for your own work. Iterate based on community insights.</p>
            </div>
        </div>
    </div>
</section>

<section class="community-benefits">
    <div class="container">
        <div class="benefits-content scroll-animate">
            <div class="benefits-text">
                <h2 class="section-title">Built for Creators</h2>
                <p>Feedback Roulette isn't just a tool; it's a community of like-minded individuals dedicated to growth and excellence.</p>
                <div class="benefit-item">
                    <i class="bi bi-lightning-charge"></i>
                    <div>
                        <h4>Fast Turnaround</h4>
                        <p>Get feedback within hours, not days, thanks to our active credit-driven ecosystem.</p>
                    </div>
                </div>
                <div class="benefit-item">
                    <i class="bi bi-shield-check"></i>
                    <div>
                        <h4>Quality Guaranteed</h4>
                        <p>Our rating system ensures that only constructive and helpful feedback is rewarded.</p>
                    </div>
                </div>
                <div class="benefit-item">
                    <i class="bi bi-people"></i>
                    <div>
                        <h4>Global Network</h4>
                        <p>Connect with experts and peers from around the world across multiple disciplines.</p>
                    </div>
                </div>
            </div>
            <div class="benefits-stats">
                <div class="stat-card scroll-animate" style="transition-delay: 0.1s;">
                    <span class="stat-number">50k+</span>
                    <span class="stat-label">Reviews Given</span>
                </div>
                <div class="stat-card scroll-animate" style="transition-delay: 0.2s;">
                    <span class="stat-number">12k+</span>
                    <span class="stat-label">Active Creators</span>
                </div>
                <div class="stat-card scroll-animate" style="transition-delay: 0.3s;">
                    <span class="stat-number">4.9/5</span>
                    <span class="stat-label">Average Satisfaction</span>
                </div>
            </div>
        </div>
    </div>
</section>

<section class="cta-bottom">
    <div class="container text-center">
        <h2 class="scroll-animate">Ready to sharpen your skills?</h2>
        <p class="scroll-animate" style="transition-delay: 0.15s;">Join thousands of creators who are already improving through Feedback Roulette.</p>
        <a href="Account/Register" class="cta-button scroll-animate" style="transition-delay: 0.3s;">Join the Community Today</a>
    </div>
</section>

<footer class="landing-footer scroll-animate">
    <div class="footer-container">
        <div class="footer-logo">
            <img src="images/feedback_roulette_logo.png" alt="Logo" class="footer-logo-img" />
            <span>FEEDBACK ROULETTE</span>
        </div>
        <div class="footer-links">
            <a href="#">About Us</a>
            <a href="#">Privacy Policy</a>
            <a href="#">Terms of Service</a>
            <a href="#">Contact</a>
        </div>
        <p class="mt-4">&copy; 2026 Feedback Roulette. Built for the community.</p>
    </div>
</footer>

@code {
    [Inject] private IJSRuntime JS { get; set; } = default!;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await JS.InvokeVoidAsync("initScrollAnimations");
        }
    }

    private int activeTab = 0;

    private void SetTab(int index)
    {
        activeTab = index;
    }

    private class TabData
    {
        public string Title { get; set; } = string.Empty;
        public string Description { get; set; } = string.Empty;
        public string ImageUrl { get; set; } = string.Empty;
        public string[] Features { get; set; } = Array.Empty<string>();
    }

    private readonly TabData[] tabs = new[]
    {
        new TabData
        {
            Title = "The Feedback Roulette",
            Description = "Our unique discovery engine that pairs you with submissions that match your expertise. It's the core of the community where growth happens.",
            ImageUrl = "images/screenshot_20260429_221835.jpg",
            Features = new[] { "Randomized discovery for unbiased reviews", "Filter by category and difficulty", "Real-time activity feed" }
        },
        new TabData
        {
            Title = "Powerful Submissions",
            Description = "Share your work with the world. Our submission process allows you to provide all the context needed for a great review.",
            ImageUrl = "images/screenshot_20260429_221852.jpg",
            Features = new[] { "Support for multiple file types", "Specific feedback requests", "Tagging system for better reach" }
        },
        new TabData
        {
            Title = "Structured Feedback",
            Description = "No more vague comments. Our review system guides users to provide actionable, high-impact feedback that you can actually use.",
            ImageUrl = "images/screenshot_20260429_221639.jpg",
            Features = new[] { "Segmented review categories", "Inline commenting", "Overall rating system" }
        },
        new TabData
        {
            Title = "Leaderboards & Recognition",
            Description = "Great feedback deserves recognition. Climb the leaderboard and earn your place among the community's elite.",
            ImageUrl = "images/screenshot_20260429_221904.jpg",
            Features = new[] { "Weekly and all-time rankings", "Skill badges and achievements", "Profile stats that show your growth" }
        }
    };
}
