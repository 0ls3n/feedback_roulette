@using FeedbackRoulette_ClassLibrary
@using Feedback_Roulette.Services
@using Microsoft.JSInterop
@attribute [Authorize]
@rendermode InteractiveServer

@inject INotificationService NotificationService
@inject IStreakService StreakService
@inject IIdentityService IdentityService
@inject NavigationManager NavigationManager
@inject IJSRuntime JSRuntime

@implements IDisposable

<div class="topbar">
    <div class="topbar-left">
        
    </div>
    <div class="topbar-actions">
        <div class="streak-display" title="Best: @longestStreak days">
            <i class="bi bi-fire"></i>
            @if (currentStreak > 0)
            {
                <span class="streak-count">@currentStreak</span>
                <span class="streak-label">day streak</span>
            }
            else
            {
                <span class="streak-label streak-start-text">Start a streak!</span>
            }
        </div>
        <div class="notification-bell-container" @ref="notificationRef">
            <button class="notification-btn" @onclick="ToggleNotificationDropdown">
                <i class="bi bi-bell"></i>
                @if (unreadCount > 0)
                {
                    <span class="notification-badge"></span>
                }
            </button>

            @if (showNotifications)
            {
                <div class="notification-dropdown" @onclick:stopPropagation>
                    <div class="notification-header">
                        <h6>Notifications</h6>
                        @if (notifications.Any(n => !n.IsRead))
                        {
                            <button class="mark-all-read-btn" @onclick="MarkAllAsRead">
                                Mark all read
                            </button>
                        }
                    </div>

                    <div class="notification-list">
                        @if (notifications.Count == 0)
                        {
                            <div class="no-notifications">
                                <i class="bi bi-bell-slash"></i>
                                <p>No notifications yet</p>
                            </div>
                        }
                        else
                        {
                            foreach (var notification in notifications)
                            {
                                <div class="notification-item @(notification.IsRead ? "read" : "unread")"
                                     @onclick="() => HandleNotificationClick(notification)">
                                    <div class="notification-content">
                                        <p>@notification.Message</p>
                                        <small>@notification.CreatedAt.ToString("MMM dd, yyyy")</small>
                                    </div>
                                    @if (!notification.IsRead)
                                    {
                                        <div class="unread-indicator"></div>
                                    }
                                </div>
                            }
                        }
                    </div>
                </div>
            }
        </div>
    </div>
</div>

@code {
    private ApplicationUser? currentUser;
    private List<Notification> notifications = new();
    private int unreadCount = 0;
    private bool showNotifications = false;
    private int currentStreak = 0;
    private int longestStreak = 0;
    private ElementReference notificationRef;

    protected override async Task OnParametersSetAsync()
    {
        await LoadTopbarData();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await JSRuntime.InvokeVoidAsync("registerClickOutside", notificationRef, DotNetObjectReference.Create(this));
        }
    }

    [JSInvokable]
    public void CloseNotificationDropdown()
    {
        if (showNotifications)
        {
            showNotifications = false;
            StateHasChanged();
        }
    }

    public void Dispose()
    {
        JSRuntime.InvokeVoidAsync("unregisterClickOutside");
    }

    private async Task LoadTopbarData()
    {
        try
        {
            currentUser = await IdentityService.GetCurrentUserAsync();
            if (currentUser != null)
            {
                notifications = await NotificationService.GetAllNotificationsAsync(currentUser.Id);
                unreadCount = await NotificationService.GetUnreadCountAsync(currentUser.Id);

                var streakData = await StreakService.GetStreakAsync(currentUser.Id);
                currentStreak = streakData.CurrentStreak;
                longestStreak = streakData.LongestStreak;

                StateHasChanged();
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error loading topbar data: {ex.Message}");
        }
    }

    private void ToggleNotificationDropdown()
    {
        showNotifications = !showNotifications;
    }

    private async Task MarkAllAsRead()
    {
        try
        {
            if (currentUser != null)
            {
                await NotificationService.MarkAllAsReadAsync(currentUser.Id);
                await LoadTopbarData();
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error marking notifications as read: {ex.Message}");
        }
    }

    private async Task HandleNotificationClick(Notification notification)
    {
        try
        {
            if (!notification.IsRead)
            {
                await NotificationService.MarkAsReadAsync(notification.Id);
                await LoadTopbarData();
            }

            if (!string.IsNullOrEmpty(notification.Link))
            {
                NavigationManager.NavigateTo(notification.Link);
            }

            showNotifications = false;
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error handling notification click: {ex.Message}");
        }
    }
}