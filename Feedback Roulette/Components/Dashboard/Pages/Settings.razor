@page "/settings"
@layout DashboardLayout
@attribute [Authorize]
@rendermode InteractiveServer

@using Feedback_Roulette.Services
@using FeedbackRoulette_ClassLibrary
@using Microsoft.AspNetCore.Identity
@using Microsoft.AspNetCore.Components.Forms

@inject IIdentityService IdentityService
@inject UserManager<ApplicationUser> UserManager
@inject IWebHostEnvironment Environment
@inject IUserSettingsService UserSettingsService

<div class="dashboard-content">
    <header class="content-header">
        <h1>Account Settings</h1>
        <p class="text-muted-custom">Manage your profile and account preferences.</p>
    </header>

    @if (currentUser == null)
    {
        <div class="settings-container">
            <div class="settings-grid">
                <div class="settings-main">
                    <section class="skeleton-card settings-section">
                        <div class="skeleton skeleton-title" style="width: 150px; margin-bottom: 2rem;"></div>
                        <div class="profile-edit">
                            <div class="skeleton" style="width: 128px; height: 128px; border-radius: 24px; flex-shrink: 0;"></div>
                            <div style="flex: 1;">
                                <div class="skeleton skeleton-text" style="width: 100%; margin-bottom: 0.5rem;"></div>
                                <div class="skeleton skeleton-text" style="width: 100%; margin-bottom: 0.5rem;"></div>
                                <div class="skeleton skeleton-text-sm" style="width: 60%;"></div>
                                <div class="skeleton skeleton-text" style="width: 100%; margin-top: 1.5rem;"></div>
                            </div>
                        </div>
                    </section>

                    <section class="skeleton-card settings-section">
                        <div class="skeleton skeleton-title" style="width: 120px; margin-bottom: 2rem;"></div>
                        <div class="toggle-list">
                            <div class="toggle-item">
                                <div>
                                    <div class="skeleton skeleton-text" style="width: 140px; margin-bottom: 0.3rem;"></div>
                                    <div class="skeleton skeleton-text-sm" style="width: 250px;"></div>
                                </div>
                                <div class="skeleton" style="width: 44px; height: 24px; border-radius: 12px;"></div>
                            </div>
                            <div class="toggle-item">
                                <div>
                                    <div class="skeleton skeleton-text" style="width: 90px; margin-bottom: 0.3rem;"></div>
                                    <div class="skeleton skeleton-text-sm" style="width: 200px;"></div>
                                </div>
                                <div class="skeleton" style="width: 44px; height: 24px; border-radius: 12px;"></div>
                            </div>
                        </div>
                    </section>

                    <section class="skeleton-card settings-section">
                        <div class="skeleton skeleton-title" style="width: 160px; margin-bottom: 2rem;"></div>
                        <div class="transaction-list">
                            <div class="transaction-item">
                                <div>
                                    <div class="skeleton skeleton-text" style="width: 110px; margin-bottom: 0.3rem;"></div>
                                    <div class="skeleton skeleton-text-sm" style="width: 80px;"></div>
                                </div>
                                <div class="skeleton" style="width: 40px; height: 20px; border-radius: 4px;"></div>
                            </div>
                            <div class="transaction-item">
                                <div>
                                    <div class="skeleton skeleton-text" style="width: 130px; margin-bottom: 0.3rem;"></div>
                                    <div class="skeleton skeleton-text-sm" style="width: 80px;"></div>
                                </div>
                                <div class="skeleton" style="width: 40px; height: 20px; border-radius: 4px;"></div>
                            </div>
                        </div>
                    </section>
                </div>

                <div class="settings-sidebar">
                    <section class="skeleton-card settings-section">
                        <div class="skeleton skeleton-title" style="width: 100px; margin-bottom: 2rem;"></div>
                        <div class="skeleton" style="width: 100%; height: 48px; border-radius: 8px; margin-bottom: 0.8rem;"></div>
                        <div class="skeleton" style="width: 100%; height: 48px; border-radius: 8px;"></div>
                    </section>

                    <section class="skeleton-card settings-section" style="border-color: rgba(255, 92, 92, 0.3);">
                        <div class="skeleton skeleton-title" style="width: 120px; margin-bottom: 1rem;"></div>
                        <div class="skeleton skeleton-text" style="width: 100%; margin-bottom: 1.5rem;"></div>
                        <div class="skeleton" style="width: 100%; height: 40px; border-radius: 8px;"></div>
                    </section>
                </div>
            </div>
        </div>
    }
    else
    {
        <div class="settings-container">
            <div class="settings-grid">
                <div class="settings-main">
                    <section class="settings-section card-custom">
                        <h3>Profile Information</h3>
                        <div class="profile-edit">
                            <div class="profile-avatar-large">
                                <img src="@(string.IsNullOrEmpty(currentUser?.ProfileImageUrl) ? $"https://ui-avatars.com/api/?name={currentUser?.UserName ?? "User"}&background=5D5FEF&color=fff&size=128" : currentUser.ProfileImageUrl)" alt="Profile" />
                                <InputFile id="profileImageFile" OnChange="HandleProfileImageUpload" accept=".jpg,.jpeg,.png,.gif" style="display: none;" />
                                <label for="profileImageFile" class="btn-change-avatar" style="cursor: pointer;">
                                    <i class="bi bi-camera"></i>
                                </label>
                            </div>
                            <div class="form-grid">
                                <div class="form-group">
                                    <label>Username</label>
                                    <input type="text" class="form-control-custom" @bind="currentUser.UserName" disabled />
                                    <span class="help-text">Username cannot be changed currently.</span>
                                </div>
                                <div class="form-group">
                                    <label>Email Address</label>
                                    <input type="email" class="form-control-custom" @bind="currentUser.Email" disabled />
                                </div>
                            </div>
                        </div>
                        @if (!string.IsNullOrEmpty(profileImageError))
                        {
                            <div class="alert alert-danger mt-3">@profileImageError</div>
                        }
                    </section>

                    <section class="settings-section card-custom">
                        <h3>Notifications</h3>
                        <div class="toggle-list">
                            <div class="toggle-item">
                                <div class="toggle-info">
                                    <strong>Email Notifications</strong>
                                    <p>Get notified when someone gives you feedback.</p>
                                </div>
                                <div class="form-check form-switch">
                                    <input class="form-check-input" type="checkbox" checked>
                                </div>
                            </div>
                            <div class="toggle-item">
                                <div class="toggle-info">
                                    <strong>Newsletter</strong>
                                    <p>Receive weekly updates about the community.</p>
                                </div>
                                <div class="form-check form-switch">
                                    <input class="form-check-input" type="checkbox">
                                </div>
                            </div>
                        </div>
                    </section>

                    <section class="settings-section card-custom">
                        <h3>Transaction History</h3>
                        <div class="transaction-list">
                            <div class="transaction-item">
                                <div class="trans-info">
                                    <span class="trans-type">Review Reward</span>
                                    <span class="trans-date">Apr 30, 2026</span>
                                </div>
                                <span class="trans-amount positive">+10</span>
                            </div>
                            <div class="transaction-item">
                                <div class="trans-info">
                                    <span class="trans-type">Upload Submission</span>
                                    <span class="trans-date">Apr 29, 2026</span>
                                </div>
                                <span class="trans-amount negative">-50</span>
                            </div>
                        </div>
                    </section>
                </div>

                <div class="settings-sidebar">
                    <section class="settings-section card-custom credits-shop">
                        <h3>Refill Credits</h3>
                        <div class="shop-item">
                            <span>100 Credits</span>
                            <button class="btn btn-purple btn-sm">$4.99</button>
                        </div>
                        <div class="shop-item">
                            <span>500 Credits</span>
                            <button class="btn btn-purple btn-sm">$19.99</button>
                        </div>
                    </section>

                    <section class="settings-section card-custom danger-zone">
                        <h3>Danger Zone</h3>
                        <p>Once you delete your account, there is no going back. Please be certain.</p>
                        <button class="btn btn-outline-danger btn-block">Delete Account</button>
                    </section>
                </div>
            </div>

            <div class="settings-actions">
                <button class="btn btn-purple" @onclick="SaveChanges">Save Changes</button>
            </div>
        </div>
    }
</div>

@code {
    private ApplicationUser? currentUser;
    private string? profileImageError;
    private readonly int maxImageSize = 1024 * 1024 * 5; // 5MB

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            currentUser = await IdentityService.GetCurrentUserAsync();
            
            StateHasChanged();
        }
    }

    private async Task HandleProfileImageUpload(InputFileChangeEventArgs e)
    {
        profileImageError = null;
        var file = e.File;

        if (file.Size > maxImageSize)
        {
            profileImageError = "Image must be smaller than 5MB.";
            return;
        }

        try
        {
            var user = await IdentityService.GetCurrentUserAsync();
            var trustedFileName = Path.GetRandomFileName() + Path.GetExtension(file.Name);
            var profileImagePath = Path.Combine(Environment.WebRootPath, "uploads", user.Id, "profile");

            if (!Directory.Exists(profileImagePath))
            {
                Directory.CreateDirectory(profileImagePath);
            }

            var filePath = Path.Combine(profileImagePath, trustedFileName);

            await using (var fs = new FileStream(filePath, FileMode.Create))
            {
                await file.OpenReadStream(maxImageSize).CopyToAsync(fs);
            }

            var profileImageUrl = $"/uploads/{user.Id}/profile/{trustedFileName}";
            await UserSettingsService.UpdateProfileImageAsync(user.Id, profileImageUrl);
            currentUser = await UserSettingsService.GetCurrentUserAsync(user.Id);

            StateHasChanged();
        }
        catch (Exception ex)
        {
            profileImageError = $"Error uploading image: {ex.Message}";
        }
    }

    private async Task SaveChanges()
    {
        // Logic to save non-disabled fields if any
        // For now just show a success message or similar
    }
}