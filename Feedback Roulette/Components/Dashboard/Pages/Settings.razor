@page "/settings"
@layout DashboardLayout
@attribute [Authorize]
@rendermode InteractiveServer

@using Feedback_Roulette.Data
@using Feedback_Roulette.Services
@using FeedbackRoulette_ClassLibrary
@using Microsoft.AspNetCore.Identity

@inject IIdentityService IdentityService
@inject UserManager<ApplicationUser> UserManager
@inject DataContext DbContext

<div class="dashboard-content">
    <header class="content-header">
        <h1>Account Settings</h1>
        <p class="text-muted-custom">Manage your profile and account preferences.</p>
    </header>

    @if (currentUser == null)
    {
        <div class="loading-state">
            <div class="spinner-border text-purple" role="status"></div>
            <p>Loading your settings...</p>
        </div>
    }
    else
    {
        <div class="settings-container">
            <div class="settings-grid">
                <div class="settings-main">
                    <section class="settings-section card-custom">
                        <h3>Profile Information</h3>
                        <div class="profile-edit">
                            <div class="profile-avatar-large">
                                <img src="https://ui-avatars.com/api/?name=@(currentUser.UserName)&background=5D5FEF&color=fff&size=128" alt="Profile" />
                                <button class="btn-change-avatar"><i class="bi bi-camera"></i></button>
                            </div>
                            <div class="form-grid">
                                <div class="form-group">
                                    <label>Username</label>
                                    <input type="text" class="form-control-custom" @bind="currentUser.UserName" disabled />
                                    <span class="help-text">Username cannot be changed currently.</span>
                                </div>
                                <div class="form-group">
                                    <label>Email Address</label>
                                    <input type="email" class="form-control-custom" @bind="currentUser.Email" disabled />
                                </div>
                            </div>
                        </div>
                    </section>

                    <section class="settings-section card-custom">
                        <h3>Notifications</h3>
                        <div class="toggle-list">
                            <div class="toggle-item">
                                <div class="toggle-info">
                                    <strong>Email Notifications</strong>
                                    <p>Get notified when someone gives you feedback.</p>
                                </div>
                                <div class="form-check form-switch">
                                    <input class="form-check-input" type="checkbox" checked>
                                </div>
                            </div>
                            <div class="toggle-item">
                                <div class="toggle-info">
                                    <strong>Newsletter</strong>
                                    <p>Receive weekly updates about the community.</p>
                                </div>
                                <div class="form-check form-switch">
                                    <input class="form-check-input" type="checkbox">
                                </div>
                            </div>
                        </div>
                    </section>

                    <section class="settings-section card-custom">
                        <h3>Transaction History</h3>
                        <div class="transaction-list">
                            <div class="transaction-item">
                                <div class="trans-info">
                                    <span class="trans-type">Review Reward</span>
                                    <span class="trans-date">Apr 30, 2026</span>
                                </div>
                                <span class="trans-amount positive">+10</span>
                            </div>
                            <div class="transaction-item">
                                <div class="trans-info">
                                    <span class="trans-type">Upload Submission</span>
                                    <span class="trans-date">Apr 29, 2026</span>
                                </div>
                                <span class="trans-amount negative">-50</span>
                            </div>
                        </div>
                    </section>
                </div>

                <div class="settings-sidebar">
                    <section class="settings-section card-custom credits-shop">
                        <h3>Refill Credits</h3>
                        <div class="shop-item">
                            <span>100 Credits</span>
                            <button class="btn btn-purple btn-sm">$4.99</button>
                        </div>
                        <div class="shop-item">
                            <span>500 Credits</span>
                            <button class="btn btn-purple btn-sm">$19.99</button>
                        </div>
                    </section>

                    <section class="settings-section card-custom danger-zone">
                        <h3>Danger Zone</h3>
                        <p>Once you delete your account, there is no going back. Please be certain.</p>
                        <button class="btn btn-outline-danger btn-block">Delete Account</button>
                    </section>
                </div>
            </div>

            <div class="settings-actions">
                <button class="btn btn-purple" @onclick="SaveChanges">Save Changes</button>
            </div>
        </div>
    }
</div>

@code {
    private ApplicationUser? currentUser;

    protected override async Task OnInitializedAsync()
    {
        currentUser = await IdentityService.GetCurrentUserAsync();
    }

    private async Task SaveChanges()
    {
        // Logic to save non-disabled fields if any
        // For now just show a success message or similar
    }
}