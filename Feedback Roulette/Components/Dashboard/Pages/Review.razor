@page "/review"
@layout DashboardLayout
@attribute [Authorize]
@rendermode InteractiveServer

@using Feedback_Roulette.Services
@using FeedbackRoulette_ClassLibrary
@using Microsoft.AspNetCore.Identity
@using Microsoft.JSInterop

@inject IIdentityService IdentityService
@inject NavigationManager NavigationManager
@inject UserManager<ApplicationUser> UserManager
@inject IJSRuntime JSRuntime
@inject INotificationService NotificationService
@inject IFeedbackItemService FeedbackItemService
@inject IFeedbackService FeedbackService

<div class="dashboard-content">
    <header class="content-header">
        <div class="back-link">
            <a href="/dashboard"><i class="bi bi-arrow-left"></i> Dashboard</a>
        </div>
        @if (currentItem != null)
        {
            <button class="btn-skip" @onclick="LoadRandomItem">Skip</button>
        }
    </header>

    @if (isLoading)
    {
        <div class="review-grid">
            <div class="skeleton-card review-main" style="padding: 2rem;">
                <div class="skeleton skeleton-text-sm" style="width: 80px; margin-bottom: 1rem;"></div>
                <div class="skeleton skeleton-title" style="width: 70%; margin-bottom: 0.5rem;"></div>
                <div class="skeleton skeleton-text" style="width: 30%; margin-bottom: 2rem;"></div>

                <div class="skeleton" style="width: 100%; height: 100px; border-radius: 12px; margin-bottom: 2.5rem;"></div>

                <div class="skeleton" style="width: 100%; height: 80px; border-radius: 12px; margin-bottom: 3rem;"></div>

                <div class="skeleton" style="width: 100%; height: 48px; border-radius: 8px;"></div>
            </div>
        </div>
    }
    else if (currentItem == null)
    {
        <div class="empty-state card-custom">
            <i class="bi bi-emoji-smile"></i>
            <h3>You're all caught up!</h3>
            <p>You have reviewed all available submissions or there are no new submissions yet. Check back later or upload your own work!</p>
            <NavLink href="upload" class="btn btn-purple">Upload New Work</NavLink>
        </div>
    }
    else
    {
        <div class="review-grid">
            <div class="review-main card-custom">
                <div class="content-info">
                    <span class="category-tag">@currentItem.Category.Name</span>
                    <h2>@currentItem.Title</h2>
                    <span class="author">by @currentItem.ApplicationUser.UserName</span>
                </div>

                <div class="player-container">
                    <div class="audio-player-wrapper">
                        @if (currentItem.FileType?.StartsWith("audio") == true)
                        {
                            <div id="waveform-player-@currentItem.Id" class="waveform-player">
                                <button class="waveform-play-btn" type="button">
                                    <i class="bi bi-play-fill"></i>
                                    <i class="bi bi-pause-fill"></i>
                                </button>
                                <div class="waveform-visual">
                                    <canvas class="waveform-canvas" width="600" height="80"></canvas>
                                    <div class="waveform-transport"></div>
                                    <div class="waveform-progress">
                                        <div class="waveform-progress-fill"></div>
                                    </div>
                                </div>
                            </div>
                        }
                        else
                        {
                            <div class="file-link-card">
                                <i class="bi bi-file-earmark-text"></i>
                                <a href="@currentItem.FileUrl" target="_blank" class="btn btn-outline-purple">View / Download File</a>
                            </div>
                        }
                    </div>
                </div>

                <div class="description-box">
                    <h4>Description & Context</h4>
                    <p>@currentItem.Description</p>
                </div>

                <div class="feedback-form">
                    @if (feedbackStep == 1)
                    {
                        <div class="step-indicator">
                            <span class="step active">1</span>
                            <span class="step-label">Choose your feedback type</span>
                        </div>

                        <div class="feedback-choice">
                            <button class="choice-btn @(isPositive ? "selected positive" : "")" @onclick="() => { isPositive = true; isNegative = false; }">
                                <i class="bi bi-hand-thumbs-up-fill"></i>
                                <span>I like it</span>
                            </button>
                            <button class="choice-btn @(isNegative ? "selected negative" : "")" @onclick="() => { isNegative = true; isPositive = false; }">
                                <i class="bi bi-hand-thumbs-down-fill"></i>
                                <span>I don't like it</span>
                            </button>
                        </div>

                        <button class="btn btn-purple btn-block" @onclick="() => { if (isPositive || isNegative) feedbackStep = 2; }" disabled="@(!isPositive && !isNegative)">
                            Continue
                        </button>
                    }
                    else if (feedbackStep == 2)
                    {
                        <div class="step-indicator">
                            <span class="step" @onclick="() => feedbackStep = 1" style="cursor: pointer;" title="Go back">1</span>
                            <span class="step active">2</span>
                            <span class="step-label">Tell us why</span>
                        </div>

                        @if (isPositive)
                        {
                            <div class="form-section">
                                <label><i class="bi bi-hand-thumbs-up"></i> What did you like?</label>
                                <textarea class="form-control-custom" rows="4" @bind="positiveFeedback" placeholder="What worked well? Be specific..."></textarea>
                                <span class="char-count">@positiveFeedback.Length / 500</span>
                            </div>
                        }

                        @if (isNegative)
                        {
                            <div class="form-section">
                                <label><i class="bi bi-hand-thumbs-down"></i> What didn't work?</label>
                                <textarea class="form-control-custom" rows="4" @bind="negativeFeedback" placeholder="What could be improved? Be constructive..."></textarea>
                                <span class="char-count">@negativeFeedback.Length / 500</span>
                            </div>
                        }

                        <div class="form-section">
                            <label><i class="bi bi-lightbulb"></i> Suggestions (optional)</label>
                            <textarea class="form-control-custom" rows="3" @bind="suggestion" placeholder="How could it be better?"></textarea>
                            <span class="char-count">@suggestion.Length / 500</span>
                        </div>

                        @if (!string.IsNullOrEmpty(errorMessage))
                        {
                            <div class="alert alert-danger mb-3">@errorMessage</div>
                        }

                        <div class="button-group">
                            <button class="btn btn-outline-secondary" @onclick="() => feedbackStep = 1">Back</button>
                            <button class="btn btn-purple" @onclick="SubmitFeedback" disabled="@isSubmitting">
                                @if (isSubmitting)
                                {
                                    <span class="spinner-border spinner-border-sm"></span>
                                    <span> Submitting...</span>
                                }
                                else
                                {
                                    <span>Submit Feedback (+10 Credits)</span>
                                }
                            </button>
                        </div>
                    }
                </div>
            </div>
        </div>
    }
</div>

@code {
    private FeedbackItem? currentItem;
    private bool isLoading = true;
    private bool isSubmitting = false;
    private int feedbackStep = 1;
    private bool isPositive = false;
    private bool isNegative = false;
    private string positiveFeedback = "";
    private string negativeFeedback = "";
    private string suggestion = "";
    private string? errorMessage;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await LoadRandomItem();
        }
    }

    private async Task LoadRandomItem()
    {
        isLoading = true;
        errorMessage = null;
        feedbackStep = 1;
        isPositive = false;
        isNegative = false;
        positiveFeedback = "";
        negativeFeedback = "";
        suggestion = "";
        StateHasChanged();

        try
        {
            var user = await IdentityService.GetCurrentUserAsync();
            
            // Get available items for review using service
            var availableItems = await FeedbackItemService.GetAvailableItemsForReviewAsync(user.Id);

            if (availableItems.Any())
            {
                var random = new Random();
                currentItem = availableItems[random.Next(availableItems.Count)];
            }
            else
            {
                currentItem = null;
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error loading random item: {ex.Message}");
        }
        finally
        {
            isLoading = false;
            StateHasChanged();
            await InitializeWaveformPlayer();
        }
    }

    private async Task InitializeWaveformPlayer()
    {
        if (currentItem?.FileType?.StartsWith("audio") == true)
        {
            await JSRuntime.InvokeVoidAsync("waveformPlayer.init", $"waveform-player-{currentItem.Id}", currentItem.FileUrl);
        }
    }

    private async Task SubmitFeedback()
    {
        if (currentItem == null) return;
        
        if (string.IsNullOrWhiteSpace(positiveFeedback) && 
            string.IsNullOrWhiteSpace(negativeFeedback) && 
            string.IsNullOrWhiteSpace(suggestion))
        {
            errorMessage = "Please provide some feedback before submitting.";
            return;
        }

        isSubmitting = true;
        errorMessage = null;
        StateHasChanged();

        try
        {
            var user = await IdentityService.GetCurrentUserAsync();
            
            // Submit feedback using service (handles credits, notification, etc.)
            await FeedbackService.SubmitFeedbackAsync(
                user.Id,
                currentItem.Id,
                positiveFeedback,
                negativeFeedback,
                suggestion
            );
            
            // Success! Load next item
            await LoadRandomItem();
        }
        catch (Exception ex)
        {
            errorMessage = $"Error submitting feedback: {ex.Message}";
        }
        finally
        {
            isSubmitting = false;
            StateHasChanged();
        }
    }
}
