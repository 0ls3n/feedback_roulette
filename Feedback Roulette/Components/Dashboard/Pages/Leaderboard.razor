@page "/leaderboard"
@layout DashboardLayout
@attribute [Authorize]
@rendermode InteractiveServer

@using Feedback_Roulette.Data
@using Feedback_Roulette.Services
@using FeedbackRoulette_ClassLibrary
@using Microsoft.EntityFrameworkCore
@using Microsoft.AspNetCore.Identity

@inject IDbContextFactory<DataContext> DbFactory
@inject IIdentityService IdentityService

<div class="dashboard-content">
    <header class="content-header">
        <h1>Leaderboard</h1>
    </header>

    @if (isLoading)
    {
        <div class="leaderboard-container">
            <div class="skeleton-card user-rank-banner">
                <div class="rank-profile">
                    <div class="skeleton skeleton-avatar" style="width: 64px; height: 64px;"></div>
                    <div class="rank-info">
                        <div class="skeleton skeleton-title" style="width: 140px; margin-bottom: 0.5rem;"></div>
                        <div class="skeleton skeleton-text" style="width: 180px;"></div>
                    </div>
                </div>
                <div class="rank-stats">
                    <div class="rank-stat">
                        <div class="skeleton" style="width: 40px; height: 28px; border-radius: 6px; margin-bottom: 4px;"></div>
                        <div class="skeleton skeleton-text-sm" style="width: 70px;"></div>
                    </div>
                    <div class="rank-stat">
                        <div class="skeleton" style="width: 40px; height: 28px; border-radius: 6px; margin-bottom: 4px;"></div>
                        <div class="skeleton skeleton-text-sm" style="width: 90px;"></div>
                    </div>
                    <div class="rank-stat">
                        <div class="skeleton" style="width: 40px; height: 28px; border-radius: 6px; margin-bottom: 4px;"></div>
                        <div class="skeleton skeleton-text-sm" style="width: 60px;"></div>
                    </div>
                </div>
            </div>

            <section class="skeleton-card top-reviewers">
                <div class="skeleton skeleton-title" style="width: 120px; margin-bottom: 1.5rem;"></div>
                <div class="reviewer-list">
                    <div class="reviewer-item" style="padding: 0.8rem 1rem;">
                        <div class="skeleton" style="width: 20px; height: 20px; border-radius: 4px; margin-right: 10px;"></div>
                        <div class="skeleton skeleton-avatar" style="width: 32px; height: 32px; margin-right: 1rem;"></div>
                        <div class="skeleton skeleton-text" style="width: 120px; height: 16px; margin: 0;"></div>
                        <div class="skeleton" style="width: 30px; height: 20px; border-radius: 4px; margin-left: auto;"></div>
                    </div>
                    <div class="reviewer-item" style="padding: 0.8rem 1rem;">
                        <div class="skeleton" style="width: 20px; height: 20px; border-radius: 4px; margin-right: 10px;"></div>
                        <div class="skeleton skeleton-avatar" style="width: 32px; height: 32px; margin-right: 1rem;"></div>
                        <div class="skeleton skeleton-text" style="width: 100px; height: 16px; margin: 0;"></div>
                        <div class="skeleton" style="width: 25px; height: 20px; border-radius: 4px; margin-left: auto;"></div>
                    </div>
                    <div class="reviewer-item" style="padding: 0.8rem 1rem;">
                        <div class="skeleton" style="width: 20px; height: 20px; border-radius: 4px; margin-right: 10px;"></div>
                        <div class="skeleton skeleton-avatar" style="width: 32px; height: 32px; margin-right: 1rem;"></div>
                        <div class="skeleton skeleton-text" style="width: 110px; height: 16px; margin: 0;"></div>
                        <div class="skeleton" style="width: 28px; height: 20px; border-radius: 4px; margin-left: auto;"></div>
                    </div>
                    <div class="reviewer-item" style="padding: 0.8rem 1rem;">
                        <div class="skeleton" style="width: 20px; height: 20px; border-radius: 4px; margin-right: 10px;"></div>
                        <div class="skeleton skeleton-avatar" style="width: 32px; height: 32px; margin-right: 1rem;"></div>
                        <div class="skeleton skeleton-text" style="width: 130px; height: 16px; margin: 0;"></div>
                        <div class="skeleton" style="width: 30px; height: 20px; border-radius: 4px; margin-left: auto;"></div>
                    </div>
                    <div class="reviewer-item" style="padding: 0.8rem 1rem;">
                        <div class="skeleton" style="width: 20px; height: 20px; border-radius: 4px; margin-right: 10px;"></div>
                        <div class="skeleton skeleton-avatar" style="width: 32px; height: 32px; margin-right: 1rem;"></div>
                        <div class="skeleton skeleton-text" style="width: 95px; height: 16px; margin: 0;"></div>
                        <div class="skeleton" style="width: 22px; height: 20px; border-radius: 4px; margin-left: auto;"></div>
                    </div>
                </div>
            </section>
        </div>
    }
    else
    {
        <div class="leaderboard-container">
            <div class="user-rank-banner card-custom">
                <div class="rank-profile">
                    <img src="@(!string.IsNullOrEmpty(currentUser?.ProfileImageUrl) ? currentUser.ProfileImageUrl : $"https://ui-avatars.com/api/?name={currentUser?.UserName}&background=5D5FEF&color=fff")" alt="User Avatar" class="rank-avatar" />
                    <div class="rank-info">
                        <h3>@currentUser?.UserName <span class="badge-pro">Pro</span></h3>
                        <p>Your current activity stats</p>
                    </div>
                </div>
                <div class="rank-stats">
                    <div class="rank-stat">
                        <span class="stat-value">@userFeedbackGiven</span>
                        <span class="stat-label">Reviews Given</span>
                    </div>
                    <div class="rank-stat">
                        <span class="stat-value">@userFeedbackReceived</span>
                        <span class="stat-label">Reviews Received</span>
                    </div>
                    <div class="rank-stat">
                        <span class="stat-value">@userSubmissions</span>
                        <span class="stat-label">Submissions</span>
                    </div>
                </div>
            </div>

            <section class="top-reviewers card-custom">
                <h3>Top Reviewers</h3>
                <div class="reviewer-list">
                    @for (int i = 0; i < topReviewers.Count; i++)
                    {
                        var reviewer = topReviewers[i];
                        <div class="reviewer-item @(reviewer.UserId == currentUser?.Id ? "current-user" : "")">
                            <span class="rank-number">@(i + 1)</span>
                            <img src="@(!string.IsNullOrEmpty(reviewer.ProfileImageUrl) ? reviewer.ProfileImageUrl : $"https://ui-avatars.com/api/?name={reviewer.UserName}&background=5D5FEF&color=fff")" alt="Avatar" class="reviewer-avatar" />
                            <span class="reviewer-name">
                                @reviewer.UserName 
                                @if (reviewer.UserId == currentUser?.Id)
                                {
                                    <span class="user-tag">You</span>
                                }
                                else
                                {
                                    <span class="badge-pro-mini">Pro</span>
                                }
                            </span>
                            <span class="reviewer-score">@reviewer.FeedbackCount</span>
                        </div>
                    }
                </div>
            </section>
        </div>
    }
</div>

@code {
    private bool isLoading = true;
    private ApplicationUser? currentUser;
    private int userFeedbackGiven;
    private int userFeedbackReceived;
    private int userSubmissions;
    private List<ReviewerRank> topReviewers = new();

    protected override async Task OnInitializedAsync()
    {
        await LoadLeaderboard();
    }

    private async Task LoadLeaderboard()
    {
        isLoading = true;
        try
        {
            currentUser = await IdentityService.GetCurrentUserAsync();
            
            using var context = DbFactory.CreateDbContext();

            // Get current user stats
            userFeedbackGiven = await context.Feedbacks.CountAsync(f => f.ApplicationUserId == currentUser.Id);
            userSubmissions = await context.FeedbackItems.CountAsync(i => i.ApplicationUserId == currentUser.Id);
            
            var mySubmissions = await context.FeedbackItems
                .Include(i => i.Feedbacks)
                .Where(i => i.ApplicationUserId == currentUser.Id)
                .ToListAsync();
            userFeedbackReceived = mySubmissions.Sum(i => i.Feedbacks.Count);

            // Get top reviewers
            var feedbackCounts = await context.Feedbacks
                .GroupBy(f => f.ApplicationUserId)
                .Select(g => new { UserId = g.Key, Count = g.Count() })
                .OrderByDescending(x => x.Count)
                .Take(10)
                .ToListAsync();

            foreach (var item in feedbackCounts)
            {
                var user = await context.Users.FirstOrDefaultAsync(u => u.Id == item.UserId);
                if (user != null)
                {
                    topReviewers.Add(new ReviewerRank 
                    { 
                        UserId = user.Id, 
                        UserName = user.UserName ?? "Unknown", 
                        ProfileImageUrl = user.ProfileImageUrl,
                        FeedbackCount = item.Count 
                    });
                }
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error loading leaderboard: {ex.Message}");
        }
        finally
        {
            isLoading = false;
        }
    }

    private class ReviewerRank
    {
        public string UserId { get; set; } = "";
        public string UserName { get; set; } = "";
        public string? ProfileImageUrl { get; set; }
        public int FeedbackCount { get; set; }
    }
}
