@page "/dashboard"
@using System.Security.Principal
@using Feedback_Roulette.Data
@using Feedback_Roulette.Services
@using FeedbackRoulette_ClassLibrary
@using Microsoft.EntityFrameworkCore
@using Microsoft.JSInterop
@using System.Threading.Tasks
@layout DashboardLayout
@attribute [Authorize]
@rendermode InteractiveServer

@inject IIdentityService IdentityService
@inject IDbContextFactory<DataContext> DbFactory
@inject NavigationManager NavigationManager
@inject INotificationService NotificationService
@inject IJSRuntime JSRuntime

@implements IDisposable

<div class="dashboard-content">
    @if (isLoading)
    {
        <div class="loading-state">
            <div class="spinner-border text-purple" role="status">
                <span class="visually-hidden">Loading...</span>
            </div>
            <p>Loading your dashboard...</p>
        </div>
    }
    else
    {
        <header class="content-header">
            <div class="welcome">
                <h1>Welcome back, @currentUser?.UserName 👋</h1>
                <p class="text-muted-custom">Help others improve and get better feedback in return.</p>
            </div>
            <div class="header-actions">
                <div class="notification-bell-container" @ref="notificationRef">
                    <button class="notification-btn" @onclick="ToggleNotificationDropdown">
                        <i class="bi bi-bell"></i>
                        @if (unreadCount > 0)
                        {
                            <span class="notification-badge"></span>
                        }
                    </button>

                    @if (showNotifications)
                    {
                        <div class="notification-dropdown" @onclick:stopPropagation>
                            <div class="notification-header">
                                <h6>Notifications</h6>
                                @if (notifications.Any(n => !n.IsRead))
                                {
                                    <button class="mark-all-read-btn" @onclick="MarkAllAsRead">
                                        Mark all read
                                    </button>
                                }
                            </div>

                            <div class="notification-list">
                                @if (notifications.Count == 0)
                                {
                                    <div class="no-notifications">
                                        <i class="bi bi-bell-slash"></i>
                                        <p>No notifications yet</p>
                                    </div>
                                }
                                else
                                {
                                    foreach (var notification in notifications)
                                    {
                                        <div class="notification-item @(notification.IsRead ? "read" : "unread")"
                                             @onclick="() => HandleNotificationClick(notification)">
                                            <div class="notification-content">
                                                <p>@notification.Message</p>
                                                <small>@notification.CreatedAt.ToString("MMM dd, yyyy")</small>
                                            </div>
                                            @if (!notification.IsRead)
                                            {
                                                <div class="unread-indicator"></div>
                                            }
                                        </div>
                                    }
                                }
                            </div>
                        </div>
                    }
                </div>
            </div>
        </header>
        
        <div class="stats-grid">
            <div class="card-custom stat-card">
                <div class="stat-info">
                    <span class="stat-label">Credits</span>
                    <span class="stat-value">@(currentUser?.Credits ?? 0)</span>
                    <span class="stat-trend positive">Available</span>
                </div>
                <div class="stat-icon purple">
                    <i class="bi bi-pentagon"></i>
                </div>
            </div>
            <div class="card-custom stat-card">
                <div class="stat-info">
                    <span class="stat-label">Feedback Given</span>
                    <span class="stat-value">@feedbackGivenCount</span>
                    <span class="stat-trend">Total</span>
                </div>
                <div class="stat-icon blue">
                    <i class="bi bi-chat-right-text"></i>
                </div>
            </div>
            <div class="card-custom stat-card">
                <div class="stat-info">
                    <span class="stat-label">Feedback Received</span>
                    <span class="stat-value">@feedbackReceivedCount</span>
                    <span class="stat-trend">Total</span>
                </div>
                <div class="stat-icon pink">
                    <i class="bi bi-chat-dots"></i>
                </div>
            </div>
        </div>

        <div class="card-custom unlock-banner">
            <div class="unlock-info">
                <h3>Give @(Math.Max(0, 3 - feedbackGivenCount % 3)) more feedback to unlock a new submission</h3>
                <div class="progress-container">
                    <div class="progress-bar-custom" style="width: @((feedbackGivenCount % 3) * 33.33)%;"></div>
                </div>
                <span class="progress-text">@(feedbackGivenCount % 3) / 3</span>
            </div>
            <button class="btn btn-purple" @onclick='() => NavigationManager.NavigateTo("/review")'>Review Now</button>
        </div>

        <section class="recent-feedback">
            <div class="section-header">
                <h2>Your Recent Submissions</h2>
                <button class="btn-text" @onclick='() => NavigationManager.NavigateTo("/submissions")'>View all</button>
            </div>

            <div class="feedback-list">
                @if (!recentSubmissions.Any())
                {
                    <div class="empty-state card-custom">
                        <i class="bi bi-folder-plus"></i>
                        <h3>No submissions yet</h3>
                        <p>
                            <NavLink href="upload">Upload something</NavLink>
                            to start!
                        </p>
                    </div>
                }
                else
                {
                    @foreach (var item in recentSubmissions)
                    {
                        <div class="card-custom submission-item"
                             @onclick='() => NavigationManager.NavigateTo($"/feedback-received/{item.Id}")'>
                            <div class="item-type-icon @(item.Category.Name?.ToLower())">
                                @if (item.Category.Name == "Music")
                                {
                                    <i class="bi bi-music-note-beamed"></i>
                                }
                                else if (item.Category.Name == "Programming")
                                {
                                    <i class="bi bi-code-slash"></i>
                                }
                                else
                                {
                                    <i class="bi bi-file-earmark-text"></i>
                                }
                            </div>

                            <div class="item-details">
                                <div class="item-title-row">
                                    <h3 class="item-title">@item.Title</h3>
                                    <span class="category-tag">@item.Category.Name</span>
                                </div>
                                <div class="item-meta">
                                    <span>Uploaded on @DateTime.Now.ToShortDateString()</span>
                                    <span class="dot-separator">•</span>
                                    <span>@item.FileSize</span>
                                </div>
                            </div>

                            <div class="item-stats">
                                <div class="stat-group">
                                    <span class="stat-value">@item.Feedbacks.Count</span>
                                    <span class="stat-label">Reviews</span>
                                </div>

                                <div class="stat-group">
                                    @if (item.Feedbacks.Any() && item.AverageRating > 0)
                                    {
                                        <div class="rating-indicator @GetRatingClass(item.AverageRating)">
                                            <i class="bi bi-star-fill"></i>
                                            <span>@item.AverageRating.ToString("0.0")</span>
                                        </div>
                                    }
                                    else
                                    {
                                        <span class="no-rating">No rating</span>
                                    }
                                </div>
                            </div>

                            <i class="bi bi-chevron-right arrow-icon"></i>
                        </div>
                    }
                }
            </div>
        </section>
    }
</div>

@code {
    private bool isLoading = true;
    private ApplicationUser? currentUser;
    private int feedbackGivenCount = 0;
    private int feedbackReceivedCount = 0;
    private List<FeedbackItem> recentSubmissions = new();
    private List<Notification> notifications = new();
    private int unreadCount = 0;
    private bool showNotifications = false;
    private ElementReference notificationRef;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await LoadDashboardData();
            await LoadNotifications();
            
            await JSRuntime.InvokeVoidAsync("registerClickOutside", notificationRef, DotNetObjectReference.Create(this));
        }
    }

    [JSInvokable]
    public void CloseNotificationDropdown()
    {
        if (showNotifications)
        {
            showNotifications = false;
            StateHasChanged();
        }
    }

    public void Dispose()
    {
        JSRuntime.InvokeVoidAsync("unregisterClickOutside");
    }

    private async Task LoadDashboardData()
    {
        isLoading = true;
        try
        {
            currentUser = await IdentityService.GetCurrentUserAsync();
            feedbackGivenCount = await DbFactory.CreateDbContextAsync().Result.Feedbacks
                .CountAsync(f => f.ApplicationUserId == currentUser.Id);
            feedbackReceivedCount = await DbFactory.CreateDbContextAsync().Result.FeedbackItems
                .Where(i => i.ApplicationUserId == currentUser.Id)
                .SelectMany(i => i.Feedbacks)
                .CountAsync();
            recentSubmissions = await DbFactory.CreateDbContextAsync().Result.FeedbackItems
                .Where(i => i.ApplicationUserId == currentUser.Id)
                .Include(i => i.Category)
                .Include(i => i.Feedbacks)
                .OrderByDescending(i => i.Id)
                .Take(3)
                .ToListAsync();
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error loading dashboard data: {ex.Message}");
        }
        finally
        {
            isLoading = false;
            StateHasChanged();
        }
    }

    private string GetRatingClass(double rating) => rating switch
    {
        <= 2.0 => "rating-red",
        <= 3.5 => "rating-yellow",
        _ => "rating-green"
    };

    private async Task LoadNotifications()
    {
        try
        {
            currentUser ??= await IdentityService.GetCurrentUserAsync();
            if (currentUser != null)
            {
                notifications = await NotificationService.GetAllNotificationsAsync(currentUser.Id);
                unreadCount = await NotificationService.GetUnreadCountAsync(currentUser.Id);
                StateHasChanged();
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error loading notifications: {ex.Message}");
        }
    }

    private void ToggleNotificationDropdown()
    {
        showNotifications = !showNotifications;
    }

    private async Task MarkAllAsRead()
    {
        try
        {
            if (currentUser != null)
            {
                await NotificationService.MarkAllAsReadAsync(currentUser.Id);
                await LoadNotifications();
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error marking notifications as read: {ex.Message}");
        }
    }

    private async Task HandleNotificationClick(Notification notification)
    {
        try
        {
            if (!notification.IsRead)
            {
                await NotificationService.MarkAsReadAsync(notification.Id);
                await LoadNotifications();
            }

            if (!string.IsNullOrEmpty(notification.Link))
            {
                NavigationManager.NavigateTo(notification.Link);
            }

            showNotifications = false;
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error handling notification click: {ex.Message}");
        }
    }
}
