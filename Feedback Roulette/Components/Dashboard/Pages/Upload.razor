@page "/upload"
@layout DashboardLayout
@attribute [Authorize]
@implements IDisposable

@using Feedback_Roulette.Services
@using FeedbackRoulette_ClassLibrary
@using Microsoft.AspNetCore.Identity

@inject IWebHostEnvironment Environment
@inject IIdentityService IdentityService
@inject NavigationManager NavigationManager
@inject UserManager<ApplicationUser> UserManager
@inject IJSRuntime JS
@inject IFeedbackItemService FeedbackItemService
@inject IUserSettingsService UserSettingsService
@inject ICategoryService CategoryService

@rendermode InteractiveServer

<div class="dashboard-content">
    <header class="content-header">
        <div class="back-link">
            <a href="/dashboard"><i class="bi bi-arrow-left"></i> Dashboard</a>
        </div>
        <h1>Upload New Submission</h1>
    </header>

    <div class="upload-container card-custom">
        <div class="drop-zone @(isDragOver ? "drag-over" : "")">
            
            <InputFile id="file-upload-input" OnChange="LoadFiles" accept=".mp3, .wav"
                       style="position: absolute; inset: 0; opacity: 0; cursor: pointer; width: 100%; height: 100%; z-index: 2;" />
            
            <div class="drop-content">
                @if (selectedFile == null)
                {
                    <i class="bi bi-cloud-upload"></i>
                    <h3>Drag & drop your file here</h3>
                    <p>or <span class="btn-link">click to browse</span></p>
                    <span class="file-types">MP3, WAV (max 200MB)</span>
                }
                else
                {
                    <i class="bi bi-file-earmark-music"></i>
                    <h3>@selectedFile.Name</h3>
                    <p>Size: @((selectedFile.Size / 1024.0 / 1024.0).ToString("F2")) MB</p>
                    <span class="btn-link">Change file</span>
                }
            </div>
        </div>

        <div class="form-group">
            <label>Title</label>
            <input type="text" class="form-control-custom" @bind="submissionTitle" placeholder="Give your work a name" />
        </div>

        <div class="form-grid">
            <div class="form-group">
                <label>Category</label>
                <select class="form-control-custom" @bind="selectedCategoryId">
                    <option value="0" disabled>Select Category</option>
                    @foreach (var category in categories)
                    {
                        <option value="@category.Id">@category.Name</option>
                    }
                </select>
            </div>
            <div class="form-group">
                <label>Genre / Language</label>
                <input type="text" class="form-control-custom" @bind="genre" placeholder="e.g. Metalcore, C#, UI Design" />
            </div>
        </div>

        <div class="form-group">
            <label>What do you want feedback on?</label>
            <textarea class="form-control-custom" rows="4" @bind="feedbackDescription" placeholder="E.g. Mix quality, Drums, Vocals, Code structure..."></textarea>
        </div>

        @if (!string.IsNullOrEmpty(errorMessage))
        {
            <div class="alert alert-danger mb-3">
                @errorMessage
            </div>
        }

        <button class="btn btn-purple btn-block" @onclick="HandleUpload" disabled="@(isUploading || selectedFile == null || string.IsNullOrWhiteSpace(submissionTitle) || selectedCategoryId == 0)">
            @if (isUploading)
            {
                <span class="spinner-border spinner-border-sm" role="status" aria-hidden="true"></span>
                <span> Uploading...</span>
            }
            else
            {
                <span>Upload Submission (50 Credits)</span>
            }
        </button>
    </div>
</div>

@code {
    private List<Category> categories = new();
    private int selectedCategoryId;
    private string submissionTitle = "";
    private string genre = "";
    private string feedbackDescription = "";
    private string? errorMessage;
    
    private IBrowserFile? selectedFile;
    private int maxFileSize = 1024 * 1024 * 200; // 200MB

    private bool isUploading = false;
    private bool isDragOver = false;
    private DotNetObjectReference<Upload>? dotNetRef;

    protected override async Task OnInitializedAsync()
    {
        categories = await CategoryService.GetCategoriesAsync();
        if (categories.Any())
        {
            selectedCategoryId = categories.First().Id;
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            dotNetRef = DotNetObjectReference.Create(this);
            await JS.InvokeVoidAsync("initFileUpload", dotNetRef);
        }
    }

    [JSInvokable]
    public void SetDragOver(bool value)
    {
        isDragOver = value;
        StateHasChanged();
    }

    public void Dispose()
    {
        dotNetRef?.Dispose();
    }

    private void LoadFiles(InputFileChangeEventArgs e)
    {
        isDragOver = false;
        selectedFile = e.File;
        errorMessage = null;
        StateHasChanged();
    }

    private async Task HandleUpload()
    {
        if (selectedFile == null || string.IsNullOrWhiteSpace(submissionTitle) || selectedCategoryId == 0) return;
        
        isUploading = true;
        errorMessage = null;
        StateHasChanged();
        
        try
        {
            var user = await IdentityService.GetCurrentUserAsync();

            // Check if user has enough credits
            if (!await UserSettingsService.HasEnoughCreditsAsync(user.Id, 50))
            {
                errorMessage = "You don't have enough credits to upload a new submission. Give some feedback to earn more!";
                isUploading = false;
                return;
            }
            
            var trustedFileName = Path.GetRandomFileName() + Path.GetExtension(selectedFile.Name);
            var userUploadPath = Path.Combine(Environment.WebRootPath, "uploads", user.Id, "submissions");
            
            if (!Directory.Exists(userUploadPath))
            {
                Directory.CreateDirectory(userUploadPath);
            }

            var filePath = Path.Combine(userUploadPath, trustedFileName);

            await using (FileStream fs = new(filePath, FileMode.Create))
            {
                await selectedFile.OpenReadStream(maxFileSize).CopyToAsync(fs);
            }

            // Create submission using service
            await FeedbackItemService.CreateSubmissionAsync(
                user.Id,
                submissionTitle,
                selectedCategoryId,
                $"{genre}\n\n{feedbackDescription}".Trim(),
                $"/uploads/{user.Id}/submissions/{trustedFileName}",
                selectedFile.ContentType,
                (selectedFile.Size / 1024.0 / 1024.0).ToString("F2") + " MB"
            );
            
            NavigationManager.NavigateTo("/dashboard");
        }
        catch (Exception ex)
        {
            errorMessage = $"Error uploading file: {ex.Message}";
        }
        finally
        {
            isUploading = false;
            StateHasChanged();
        }
    }
}
