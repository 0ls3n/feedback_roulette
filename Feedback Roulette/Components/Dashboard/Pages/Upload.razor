@page "/upload"
@layout DashboardLayout

<div class="dashboard-content">
    <header class="content-header">
        <div class="back-link">
            <a href="/dashboard"><i class="bi bi-arrow-left"></i> Dashboard</a>
        </div>
        <h1>Upload New Submission</h1>
    </header>

    <div class="upload-container card-custom">
        <div class="drop-zone">
            <div class="drop-content">
                <i class="bi bi-cloud-upload"></i>
                <h3>Drag & drop your file here</h3>
                <p>or <button class="btn-link">click to browse</button></p>
                <span class="file-types">MP3, WAV, MP4, ZIP, C#, JS, etc. (max 200MB)</span>
            </div>
        </div>

        <div class="form-grid">
            <div class="form-group">
                <label>Category</label>
                <select class="form-control-custom">
                    <option>Music</option>
                    <option>Programming</option>
                    <option>Design</option>
                </select>
            </div>
            <div class="form-group">
                <label>Genre / Language</label>
                <select class="form-control-custom">
                    <option>Metalcore</option>
                    <option>C#</option>
                    <option>UI Design</option>
                </select>
            </div>
        </div>

        <div class="form-group">
            <label>What do you want feedback on?</label>
            <textarea class="form-control-custom" rows="4" placeholder="E.g. Mix quality, Drums, Vocals, Code structure..."></textarea>
        </div>

        <button class="btn btn-purple btn-block">Upload Submission</button>
    </div>
</div>
