                                @if (item.Category.Name == "Music") { <i class="bi bi-music-note-beamed"></i> }
                                else if (item.Category.Name == "Programming") { <i class="bi bi-code-slash"></i> }
                                else { <i class="bi bi-file-earmark-text"></i> }
                            </div>
                            <div class="item-info-large">
                                <h3>@item.Title</h3>
                                <span>@item.Category.Name</span>
                            </div>
                        </div>
                        <div class="rating-badge-large">
                            @if (item.AverageRating > 0)
                            {
                                <span class="rating-value @GetRatingClass(item.AverageRating)">@item.AverageRating.ToString("0.0")</span>
                                <span class="rating-label">Average rating</span>
                            }
                            else
                            {
                                <span class="rating-value">@item.Feedbacks.Count</span>
                                <span class="rating-label">Total reviews received</span>
                            }
                        </div>
                    </div>

                    <div class="tabs-container">
                        <button class="tab @(activeTab == "all" ? "active" : "")" @onclick='() => activeTab = "all"'>All Feedback (@item.Feedbacks.Count)</button>
                        <button class="tab @(activeTab == "summary" ? "active" : "")" @onclick='() => activeTab = "summary"'>Summary</button>
                    </div>

                    @if (activeTab == "all")
                    {
                        <section class="feedback-details-list">
                            @if (!item.Feedbacks.Any())
                            {
                                <div class="empty-state-small mt-4">
                                    <p>No feedback received yet. Your work is still in the roulette!</p>
                                </div>
                            }
                            else
                            {
                                @foreach (var feedback in item.Feedbacks)
                                {
                                    <div class="card-custom feedback-detail-item mb-3">
                                        <div class="feedback-header">
                                            <span class="reviewer-name">Reviewer</span>
                                            <span class="feedback-date">Just now</span>
                                        </div>

                                        @if (!string.IsNullOrWhiteSpace(feedback.PositiveFeedback))
                                        {
                                            <div class="feedback-section positive">
                                                <label><i class="bi bi-hand-thumbs-up"></i> What works well</label>
                                                <p>@feedback.PositiveFeedback</p>
                                            </div>
                                        }

                                        @if (!string.IsNullOrWhiteSpace(feedback.NegativeFeedback))
                                        {
                                            <div class="feedback-section negative">
                                                <label><i class="bi bi-hand-thumbs-down"></i> What could be improved</label>
                                                <p>@feedback.NegativeFeedback</p>
                                            </div>
                                        }

                                        @if (!string.IsNullOrWhiteSpace(feedback.Suggestion))
                                        {
                                            <div class="feedback-section suggestion">
                                                <label><i class="bi bi-wrench"></i> Suggestions</label>
                                                <p>@feedback.Suggestion</p>
                                            </div>
                                        }
                                    </div>
                                }
                            }
                        </section>
                    }
                    else
                    {
                        <section class="feedback-summary">
                            <div class="summary-content">
                                <h3>Feedback Overview</h3>
                                <p class="ai-note">Breakdown of the feedback types received for this submission.</p>

                                <ul class="pattern-list">
                                    <li>
                                        <i class="bi bi-hand-thumbs-up pattern-icon green"></i>
                                        <div>
                                            <strong>@item.Feedbacks.Count(f => f.HasPositiveFeedback) Positive highlights</strong>
                                            <p>Reviewers found things they liked in your work.</p>
                                        </div>
                                    </li>
                                    <li>
                                        <i class="bi bi-hand-thumbs-down pattern-icon orange"></i>
                                        <div>
                                            <strong>@item.Feedbacks.Count(f => f.HasNegativeFeedback) Areas for improvement</strong>
                                            <p>Common pain points identified by the community.</p>
                                        </div>
                                    </li>
                                    <li>
                                        <i class="bi bi-lightbulb pattern-icon purple"></i>
                                        <div>
                                            <strong>@item.Feedbacks.Count(f => f.HasSuggestion) Practical suggestions</strong>
                                            <p>Actionable advice to take your work to the next level.</p>
                                        </div>
                                    </li>
                                </ul>
                            </div>
                        </section>
                    }
                </div>
            </div>
            </div>
            }
        }
    </div>
}

@code {
    [Parameter]
    public int? ItemId { get; set; }

    private FeedbackItem? item;
    private List<FeedbackItem> submissionsWithFeedback = new();
    private bool isLoading = true;
    private string activeTab = "all";

    private string GetRatingClass(double rating) => rating switch
    {
        <= 2.0 => "rating-red",
        <= 3.5 => "rating-yellow",
        _ => "rating-green"
    };

    protected override async Task OnParametersSetAsync()
    {
        await LoadData();
    }

    private async Task LoadData()
    {
        isLoading = true;
        try
        {
            var user = await IdentityService.GetCurrentUserAsync();

            if (ItemId.HasValue)
            {
                // Just load the specific item
                item = await FeedbackItemService.GetSubmissionByIdAsync(ItemId.Value, user.Id);
            }
            else
            {
                // Load all submissions with feedback for the sidebar
                submissionsWithFeedback = await FeedbackItemService.GetSubmissionsWithFeedbackAsync(user.Id);
                item = submissionsWithFeedback.FirstOrDefault();
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error loading feedback data: {ex.Message}");
        }
        finally
        {
            isLoading = false;
        }
    }
}
